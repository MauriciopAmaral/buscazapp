# ============================================================
# BuscaZapp — Variáveis de ambiente
# Copie este arquivo para ".env" e preencha com os dados
# do banco MySQL criado no hPanel da Hostinger.
# ============================================================

# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Exemplo com banco hospedado na Hostinger (acesso remoto liberado):
# DATABASE_URL="mysql://u123456789_buscazapp:SUASENHA@srv123.hstgr.io:3306/u123456789_buscazapp"
DATABASE_URL=""

# Chave usada pra assinar os tokens (JWT) de login da API.
# Gere uma string aleatória longa, por exemplo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NUNCA reutilize a mesma chave de exemplo em produção.
JWT_SECRET=""

# Mantido por compatibilidade / uso futuro (ex: se migrar pra NextAuth).
AUTH_SECRET=""

# ============================================================
# Upload de fotos (logo, capa, galeria, produtos, serviços)
# Usa a MESMA hospedagem Hostinger do banco como armazenamento
# de arquivos, via FTP — não precisa de nenhum serviço pago.
# Veja o guia completo em HOSTINGER_MYSQL_SETUP.md.
# ============================================================

# Endereço do servidor FTP. Geralmente é o próprio domínio ou um
# host tipo "ftp.seudominio.com.br" — confira em hPanel > Contas FTP.
FTP_HOST=""

# Usuário da conta FTP criada no hPanel (ex: uma conta FTP dedicada
# pra pasta de uploads, não precisa ser a conta FTP principal).
FTP_USER=""

# Senha da conta FTP.
FTP_PASSWORD=""

# Caminho, dentro da conta FTP, onde as imagens serão salvas.
# Padrão: /public_html/uploads (uma pasta dentro do public_html do
# domínio, pra ficar acessível publicamente por HTTPS).
FTP_BASE_PATH="/public_html/uploads"

# Se a conexão FTP deve usar FTPS (FTP com TLS). A Hostinger geralmente
# suporta e é o mais seguro — deixe "true" a menos que dê erro de conexão.
FTP_SECURE="true"

# Porta do servidor FTP. Padrão: 21 (a porta FTP de sempre).
FTP_PORT="21"

# Se "true", exige que o certificado TLS do servidor bata exatamente com o
# host usado na conexão. Deixe "false" (padrão) se você conecta pelo IP do
# servidor — a maioria das hospedagens compartilhadas (Hostinger inclusive)
# serve um certificado emitido pro domínio principal, não pro IP, e isso
# causa o erro "Hostname/IP does not match certificate's altnames".
FTP_TLS_REJECT_UNAUTHORIZED="false"

# URL pública que corresponde exatamente à pasta acima (FTP_BASE_PATH).
# Se a pasta é /public_html/uploads dentro do domínio buscazap.com.br
# (mesmo domínio do site) o valor é:
#   UPLOADS_PUBLIC_URL="https://buscazap.com.br/uploads"
# Se você usar um subdomínio ou domínio separado pra hospedar os
# arquivos, ajuste de acordo.
UPLOADS_PUBLIC_URL=""

# ============================================================
# Pagamentos — Mercado Pago (Painel da empresa > Impulsionar)
# Usado pra cobrar o Impulsionar sem sair do site (Payment Brick —
# cartão de crédito ou Pix, boleto desativado). Veja o guia completo em
# HOSTINGER_MYSQL_SETUP.md.
# ============================================================

# Access Token de PRODUÇÃO da sua conta Mercado Pago (não a Public Key).
# Pegue em: https://www.mercadopago.com.br/developers/panel/app
#   > sua aplicação > "Credenciais de produção" > Access Token.
# NUNCA coloque o token real aqui nem no repositório — configure o valor
# de verdade direto nas variáveis de ambiente do Vercel. Fica só no
# servidor (nunca vai pro navegador).
MP_ACCESS_TOKEN=""

# Public Key de PRODUÇÃO da mesma aplicação Mercado Pago. Diferente do
# Access Token, essa é feita pra ir pro navegador — é o que carrega o
# formulário de pagamento (Payment Brick) embutido na página do
# Impulsionar. Por causa do prefixo NEXT_PUBLIC_, esse valor fica visível
# no código do site publicado (isso é esperado e seguro — é assim que a
# própria Mercado Pago recomenda usar a Public Key).
NEXT_PUBLIC_MP_PUBLIC_KEY=""

# URL base pública do site em produção (sem barra no final), usada pra
# montar a URL do webhook que o Mercado Pago chama depois do pagamento, e
# também o link de cadastro mandado por e-mail depois da compra de um
# plano (ver RESEND_API_KEY abaixo).
# Ex: "https://www.buscazap.com"
SITE_BASE_URL=""

# ============================================================
# Resend (envio de e-mails transacionais) — usado pela compra de planos
# (página pública "Para empresas" → Planos): manda o e-mail com o link pra
# completar o cadastro depois do pagamento aprovado, e o e-mail de boas-
# vindas com os dados de acesso depois do cadastro concluído. Ver
# HOSTINGER_MYSQL_SETUP.md.
# ============================================================

# Chave de API do Resend (https://resend.com/api-keys). Sem essa variável,
# nenhum e-mail é enviado de verdade — só fica registrado no log do
# servidor (não quebra o fluxo de pagamento/cadastro, só não avisa por
# e-mail).
RESEND_API_KEY=""

# Remetente dos e-mails, no formato "Nome <email@dominio>". Precisa ser um
# domínio verificado no Resend (Domains → Add domain) — sem isso o Resend
# recusa o envio. Ex: "BuscaZapp <contato@buscazap.com>"
RESEND_FROM_EMAIL=""

# ============================================================
# Lembrete de vencimento da assinatura (tarefa agendada da Vercel — ver
# vercel.json e src/app/api/cron/lembretes-assinatura/route.ts). Roda 1x
# por dia sozinha, manda e-mail pras empresas com assinatura vencendo nos
# próximos dias, com o link pra pagar (usa o RESEND_API_KEY acima).
# ============================================================

# Senha que só a Vercel conhece, pra provar que quem chamou a rota do
# lembrete foi mesmo a tarefa agendada dela (e não qualquer pessoa na
# internet mandando e-mail em massa pros seus clientes). Gere um valor
# aleatório qualquer (ex: `openssl rand -hex 32`) e configure ele duas
# vezes na Vercel: aqui como variável de ambiente normal, E em Project
# Settings → Cron Jobs (a Vercel usa esse mesmo valor pra assinar a
# chamada automaticamente). Sem essa variável, a rota funciona sem checar
# nada — ok pra testar, mas não recomendado em produção.
CRON_SECRET=""
